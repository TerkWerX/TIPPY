<Window x:Class="Tippy.App.CompatibleApplicationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find applications that work with Tippy" Width="980" Height="650" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Find compatible applications" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Tippy checks installed-program entries, Start Menu shortcuts, and visible running apps, then matches them locally against its shortcut catalog."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="No documents, browser history, application data, or inventory leave this PC. Nothing is added until you review and select it."
                       Foreground="{DynamicResource AccentBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,10">
            <TextBlock x:Name="StatusText" Text="Ready to scan" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Select all new" Click="SelectAll_Click" Margin="0,0,8,0"/>
                <Button Content="Clear" Click="Clear_Click" Margin="0,0,8,0"/>
                <Button Content="Scan again" Click="ScanAgain_Click"/>
            </WrapPanel>
        </Grid>

        <DataGrid Grid.Row="2" x:Name="ApplicationsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                  IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  SelectionMode="Extended" SelectionUnit="FullRow" Foreground="{DynamicResource TextBrush}"
                  Background="{DynamicResource SurfaceBrush}" RowBackground="{DynamicResource SurfaceBrush}"
                  AlternatingRowBackground="{DynamicResource SurfaceAltBrush}" AlternationCount="2"
                  BorderBrush="{DynamicResource BorderBrush}" HorizontalGridLinesBrush="{DynamicResource BorderBrush}">
            <DataGrid.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="Padding" Value="9,7"/>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="7,5"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Add" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanAdd}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      AutomationProperties.Name="{Binding SelectionLabel}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Tippy application" Binding="{Binding ApplicationName}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="Found as" Binding="{Binding FoundAs}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Source" Binding="{Binding Evidence}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Shortcuts" Binding="{Binding ShortcutCount}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Selected applications receive complete three-bank scenes copied from the pedals currently configured in Tippy."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button Content="Add selected scenes" Click="AddSelected_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
