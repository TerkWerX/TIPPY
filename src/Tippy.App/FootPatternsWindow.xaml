<Window x:Class="Tippy.App.FootPatternsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy foot patterns" Width="900" Height="650" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="Foot patterns" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Create commands from pedals pressed together or in a particular order. Patterns can span several USB controls."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="PatternsList" DisplayMemberPath="Name" SelectionChanged="PatternsList_SelectionChanged"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add" Click="Add_Click" Margin="0,0,7,0"/>
                    <Button Content="Remove" Click="Remove_Click"/>
                </StackPanel>
            </Grid>
            <Border x:Name="Editor" Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBox x:Name="NameBox" Margin="0,6,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="PATTERN TYPE" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><ComboBox x:Name="TypeBox" Margin="0,6,0,0"><ComboBoxItem Tag="Combination"><TextBlock Text="Pressed together" Foreground="#111820"/></ComboBoxItem><ComboBoxItem Tag="Sequence"><TextBlock Text="Pressed in order" Foreground="#111820"/></ComboBoxItem></ComboBox></StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,15,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="PEDALS IN THIS PATTERN" Style="{StaticResource SmallMutedText}" FontWeight="Bold" VerticalAlignment="Center"/>
                        <WrapPanel Grid.Column="1"><Button x:Name="CapturePatternButton" Content="Capture with feet" Click="CapturePattern_Click" Margin="0,0,7,0"/><Button Content="Add pedal" Click="AddTrigger_Click" Margin="0,0,7,0"/><Button Content="Remove selected" Click="RemoveTrigger_Click"/></WrapPanel>
                    </Grid>
                    <ListBox x:Name="TriggersList" Grid.Row="2"/>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <CheckBox x:Name="EnabledCheckBox" Content="Pattern enabled"/>
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBlock Text="Time window (ms)" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="WindowBox" Width="80" Text="500"/></StackPanel>
                            <TextBlock x:Name="ActionSummary" Style="{StaticResource SmallMutedText}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Edit pattern action" Click="EditAction_Click" VerticalAlignment="Bottom" Background="{DynamicResource AccentSoftBrush}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save patterns" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
