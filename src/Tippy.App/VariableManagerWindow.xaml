<Window x:Class="Tippy.App.VariableManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy variable manager" Width="780" Height="660" MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Named variables" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Give reusable values clear names, then insert them as {name} in text, program paths, arguments, OSC values, and other macro fields."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DataGrid x:Name="VariablesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                          CellEditEnding="VariablesGrid_CellEditEnding" SelectionChanged="VariablesGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                        <DataGridTextColumn Header="Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0"><Button Content="Add variable" Click="Add_Click" Margin="0,0,8,0"/><Button Content="Duplicate" Click="Duplicate_Click" Margin="0,0,8,0"/><Button Content="Remove" Click="Remove_Click"/></StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
                <StackPanel>
                    <TextBlock Text="AVAILABLE BUILT-INS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <TextBlock x:Name="BuiltInsText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,9,0,0"/>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="SELECTED TOKEN" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <TextBlock x:Name="TokenText" Text="Select a variable" FontFamily="Consolas" FontSize="16" Margin="0,7,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LIVE PREVIEW" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                <TextBox Grid.Row="1" x:Name="PreviewSourceBox" Text="Profile {profile}: {greeting} — {date} {time}" Margin="0,8,0,0" TextChanged="PreviewSourceBox_TextChanged"/>
                <TextBlock Grid.Row="2" x:Name="PreviewResultText" TextWrapping="Wrap" FontSize="15" Margin="0,9,0,0"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save variables" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
