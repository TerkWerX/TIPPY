<Window x:Class="Tippy.App.LearnPedalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learn New Pedal" Width="840" Height="740" MinWidth="740" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Learn New Pedal" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Teach Tippy an unknown USB HID foot control—no driver or code changes required."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="1  SELECT THE HID DEVICE" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,7"/>
                <ComboBox x:Name="CandidateBox" DisplayMemberPath="DisplayName" SelectionChanged="CandidateBox_SelectionChanged"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh devices" Click="Refresh_Click" Margin="10,23,0,0"/>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="145"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DEVICE DETAILS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <TextBlock x:Name="DeviceDetailsText" Text="Choose a device above." TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="MAPPING NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <TextBox x:Name="MappingNameBox" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="NUMBER OF SWITCHES" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <ComboBox x:Name="SwitchCountBox" Margin="0,6,0,0"
                              SelectionChanged="SwitchCountBox_SelectionChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="2  CAPTURE EACH SWITCH" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SwitchStepsPanel"/>
            </ScrollViewer>
            <TextBlock Grid.Row="2" x:Name="LearningHint" Text="Release every switch before starting a capture. Tippy stores only the small HID reports shown here."
                       TextWrapping="Wrap" Style="{StaticResource SmallMutedText}" Margin="0,10,0,0"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,20,0,0">
            <TextBlock x:Name="ResultHint" Text="Capture every switch to finish." Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                <Button x:Name="FinishButton" Content="Save learned pedal" Click="Finish_Click" IsEnabled="False"
                        Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
