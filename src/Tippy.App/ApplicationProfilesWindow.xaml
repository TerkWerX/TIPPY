<Window x:Class="Tippy.App.ApplicationProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy application profiles" Width="860" Height="590" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Foreground application profiles" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Choose which bank each pedal uses for an application. Tippy checks the foreground program only when a pedal is pressed—there is no background process polling."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,16"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="ProfilesList" SelectionChanged="ProfilesList_SelectionChanged">
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Margin="8,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding DisplayProcess}" Style="{StaticResource SmallMutedText}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add executable" Click="AddProfile_Click" Margin="0,0,7,0" Background="{DynamicResource AccentSoftBrush}"/>
                    <Button Content="Remove" Click="RemoveProfile_Click"/>
                </StackPanel>
            </Grid>

            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditorPanel">
                        <TextBlock Text="PROFILE NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                        <TextBox x:Name="ProfileNameBox" Margin="0,6,0,13"/>
                        <TextBlock Text="EXECUTABLE" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                        <TextBox x:Name="ExecutablePathBox" IsReadOnly="True" Margin="0,6,0,9"/>
                        <CheckBox x:Name="EnabledCheckBox" Content="Enable automatic selection for this application" Margin="0,0,0,17"/>
                        <TextBlock Text="PEDAL BANKS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                        <TextBlock Text="Set every pedal independently. Update captures the banks currently selected in the main window."
                                   Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <StackPanel x:Name="DeviceBanksPanel"/>
                        <Button Content="Use current pedal banks" Click="UseCurrentBanks_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save profiles" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
