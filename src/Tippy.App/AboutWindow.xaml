<Window x:Class="Tippy.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Tippy" Width="570" Height="720" MinWidth="500" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Tippy;component/Assets/Icons/tippy.ico"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" Padding="20">
            <Image Source="/Tippy;component/Assets/Branding/tippy-toes-tippy.png" Stretch="Uniform"/>
        </Border>
        <TextBlock Grid.Row="1" Text="Tippy" FontSize="30" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,18,0,0"/>
        <StackPanel Grid.Row="2" HorizontalAlignment="Center">
            <TextBlock x:Name="VersionText" Style="{StaticResource SmallMutedText}" HorizontalAlignment="Center"/>
            <TextBlock Text="Low-latency foot control macros for Windows 11"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <TextBlock Text="Built for Infinity, AltoEdge, and learnable USB transcription pedals."
                       Style="{StaticResource SmallMutedText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,18,0,0">
            <TextBlock Text="Tippy is free. If it brought an old pedal back to life, optional support helps keep it growing."
                       Style="{StaticResource SmallMutedText}" TextAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="470"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="♥  Support Tippy with PayPal" Click="SupportTippy_Click"
                        Background="{DynamicResource AccentBrush}" Foreground="#101820"
                        ToolTip="Open Tippy's public PayPal.Me page in your browser" Margin="0,0,8,0"/>
                <Button Content="Close" IsCancel="True" MinWidth="110"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
