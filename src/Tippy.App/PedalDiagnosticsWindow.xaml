<Window x:Class="Tippy.App.PedalDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy pedal diagnostics" Width="920" Height="640" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Live pedal diagnostics" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Event timing, simultaneous switches, raw reports, reconnects, and privacy-safe support export. No typed keyboard content is collected."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,15,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="EVENTS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="EventCountText" Text="0" FontSize="21"/></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="PRESSED NOW" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="PressedCountText" Text="0" FontSize="21"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="ROUTING LATENCY" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="LatencyText" Text="—" FontSize="21"/></StackPanel>
                <StackPanel Grid.Column="3"><TextBlock Text="CONNECTED" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="ConnectedText" Text="0" FontSize="21"/></StackPanel>
            </Grid>
        </Border>
        <DataGrid x:Name="EventsGrid" Grid.Row="2" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95"/>
                <DataGridTextColumn Header="Device" Binding="{Binding Device}" Width="*"/>
                <DataGridTextColumn Header="Switch" Binding="{Binding Switch}" Width="70"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="85"/>
                <DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="90"/>
                <DataGridTextColumn Header="Raw report" Binding="{Binding Raw}" Width="220"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Clear" Click="Clear_Click" Margin="0,0,8,0"/>
            <Button Content="Export support report" Click="Export_Click" Background="{DynamicResource AccentSoftBrush}"/>
        </StackPanel>
    </Grid>
</Window>
