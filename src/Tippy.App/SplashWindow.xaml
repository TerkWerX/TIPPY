<Window x:Class="Tippy.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="620" Height="650" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="22" Padding="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.45" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Image Source="/Tippy;component/Assets/Branding/tippy-toes-tippy.png"
                   Stretch="Uniform" Margin="24,4" SnapsToDevicePixels="True"/>
            <TextBlock Grid.Row="1" Text="TIPPY" FontSize="34" FontWeight="Bold"
                       Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Grid.Row="2" Text="Foot control → fast macros" Style="{StaticResource SmallMutedText}"
                       HorizontalAlignment="Center" Margin="0,4,0,2"/>
            <TextBlock Grid.Row="3" Text="by TerkWerX.com © 2026" FontSize="15" FontWeight="SemiBold"
                       Foreground="#C8D3DF" HorizontalAlignment="Center" Margin="0,7,0,0"/>
        </Grid>
    </Border>
</Window>
