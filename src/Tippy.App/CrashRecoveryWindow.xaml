<Window x:Class="Tippy.App.CrashRecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy recovery" Width="640" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="Tippy did not close cleanly" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Your current profile has not been discarded. You can start normally or restore the newest automatic backup before Tippy begins listening to any pedals."
                   TextWrapping="Wrap" Style="{StaticResource SmallMutedText}" Margin="0,8,0,18"/>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
            <StackPanel>
                <TextBlock x:Name="PreviousSessionText" TextWrapping="Wrap"/>
                <TextBlock x:Name="BackupText" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <WrapPanel Margin="0,16,0,0">
                    <Button Content="Prepare crash report" Click="PrepareReport_Click" Margin="0,0,8,8"/>
                    <Button Content="Open diagnostic logs folder" Click="OpenLogs_Click" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="Reports stay on this PC until you review them and deliberately attach them to a GitHub issue."
                           Style="{StaticResource SmallMutedText}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Restore newest backup" x:Name="RestoreButton" Click="Restore_Click" Margin="0,0,8,0"/>
            <Button Content="Start normally" Click="Normal_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
