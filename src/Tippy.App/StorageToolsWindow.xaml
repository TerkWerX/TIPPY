<Window x:Class="Tippy.App.StorageToolsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy storage" Width="720" Height="520" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Profiles, backups &amp; portable mode" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="LocationText" Style="{StaticResource SmallMutedText}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel>
        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,15,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ModeText" FontWeight="SemiBold"/><TextBlock Text="Portable mode stores the live profile and backups beside Tippy, suitable for a USB drive. A restart applies mode changes." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,12,0"/></StackPanel><Button x:Name="PortableButton" Grid.Column="1" Click="Portable_Click" VerticalAlignment="Center"/></Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="RECENT BACKUPS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><Button Content="Create backup now" Click="Backup_Click" HorizontalAlignment="Right"/></Grid><ListBox x:Name="BackupsList" Grid.Row="1" Margin="0,9,0,0"/></Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0"><Button Content="Restore selected" Click="Restore_Click" Margin="0,0,8,0" Background="{DynamicResource AccentSoftBrush}"/><Button Content="Close" IsCancel="True"/></StackPanel>
    </Grid>
</Window>
