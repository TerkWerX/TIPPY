<Window x:Class="Tippy.App.OscSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy OSC output setup" Width="760" Height="650" MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="OSC endpoints" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Create reusable destinations for OBS, DAWs, lighting, streaming tools, and other OSC software. Macros keep the preset ID, so changing an endpoint updates every linked action."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DataGrid x:Name="EndpointsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionChanged="EndpointsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Preset name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="Host or IP" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                    <DataGridTextColumn Header="Port" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <Grid Grid.Row="1" Margin="0,9,0,0">
                <StackPanel Orientation="Horizontal"><Button Content="Add endpoint" Click="Add_Click" Margin="0,0,8,0"/><Button Content="Remove" Click="Remove_Click"/></StackPanel>
                <CheckBox x:Name="DefaultCheckBox" Content="Use selected endpoint as the default" HorizontalAlignment="Right" VerticalAlignment="Center" Checked="DefaultCheckBox_Changed"/>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LIVE OSC TEST" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="Address" Margin="0,0,0,4"/><TextBox x:Name="AddressBox" Text="/tippy/test"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="Values (comma separated)" Margin="0,0,0,4"/><TextBox x:Name="ValuesBox" Text="1,Tippy"/></StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="0,11,0,0">
                    <TextBlock x:Name="StatusText" Text="Select an endpoint, then send a standards-compliant OSC packet." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,150,0"/>
                    <Button Content="Send test packet" Click="Test_Click" HorizontalAlignment="Right" Background="{DynamicResource AccentSoftBrush}"/>
                </Grid>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save OSC endpoints" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
