<Window x:Class="Tippy.App.RawInputLearnWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Learn keyboard-style pedal" Width="720" Height="560" MinWidth="620" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Learn a keyboard-emulating pedal" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Raw Input lets Tippy distinguish this physical keyboard-class device from your normal keyboard. Select carefully: choosing your main keyboard would remap keys from that keyboard." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel>
        <StackPanel Grid.Row="1" Margin="0,16,0,0"><TextBlock Text="RAW KEYBOARD DEVICE" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" Margin="0,6,0,0" SelectionChanged="DeviceBox_SelectionChanged"/></StackPanel>
        <Grid Grid.Row="2" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="PEDAL NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBox x:Name="NameBox" Text="Keyboard-style pedal" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="SWITCH COUNT" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><ComboBox x:Name="SwitchCountBox" Margin="0,6,0,0" SelectionChanged="SwitchCountBox_SelectionChanged"/></StackPanel></Grid>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="CAPTURED PHYSICAL KEYS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><ListBox x:Name="MappingsList" Margin="0,8,0,10"/><Button x:Name="CaptureButton" Content="Capture next pedal switch" Click="Capture_Click" HorizontalAlignment="Left" Background="{DynamicResource AccentSoftBrush}"/><TextBlock x:Name="CaptureText" Text="Press Capture, then press only the requested foot switch." Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save keyboard pedal" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/></StackPanel>
    </Grid>
</Window>
