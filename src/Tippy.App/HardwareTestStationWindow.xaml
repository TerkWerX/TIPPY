<Window x:Class="Tippy.App.HardwareTestStationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy hardware-in-the-loop station" Width="980" Height="720" MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Hardware-in-the-loop test station" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="Exercise a real pedal through hot-plug, multi-switch, soak, cleanup, and actual macro-output dispatch. This station never simulates a passing hardware result."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,17,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" MinWidth="380"/>
            <Button Grid.Column="1" x:Name="StartButton" Content="Start physical test" Click="Start_Click" Margin="10,0,8,0" Background="{DynamicResource AccentSoftBrush}"/>
            <Button Grid.Column="2" Content="Reset" Click="Reset_Click"/>
        </Grid>
        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,12">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="SOAK CYCLES" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="SoakText" Text="0 / 10" FontSize="19" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="HOT-PLUG CLEANUP" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="HotPlugText" Text="Not tested" FontSize="19" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0"><StackPanel><TextBlock Text="OUTPUT DISPATCH" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="OutputText" Text="No samples" FontSize="19" Margin="0,4,0,0"/></StackPanel></Border>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="RESULT" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="ResultText" Text="Ready" FontSize="19" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border>
        </UniformGrid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15">
                <StackPanel>
                    <TextBlock Text="PHYSICAL TEST PLAN" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                    <TextBlock x:Name="CyclesCheckText" Text="○ 10 press/release cycles per switch" Margin="0,12,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TogetherCheckText" Text="○ Simultaneous switches" Margin="0,9,0,0"/>
                    <TextBlock x:Name="ReconnectCheckText" Text="○ Disconnect and reconnect" Margin="0,9,0,0"/>
                    <TextBlock x:Name="CleanupCheckText" Text="○ Unplug while held; synthetic release" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <TextBlock x:Name="OutputCheckText" Text="○ ≥5 mapped output samples; p50 ≤5 ms, p99 ≤10 ms" Margin="0,9,0,0" TextWrapping="Wrap"/>
                    <Separator Margin="0,14"/>
                    <TextBlock Text="Assign at least one real output to this pedal before starting. Press every switch ten times, press two together, then unplug once while holding a switch and reconnect. Tippy correlates the physical HID receipt with the output dispatch timestamp."
                               Style="{StaticResource SmallMutedText}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <DataGrid Grid.Column="2" x:Name="EventsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="95"/><DataGridTextColumn Header="Kind" Binding="{Binding Kind}" Width="105"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/><DataGridTextColumn Header="Latency" Binding="{Binding Latency}" Width="100"/></DataGrid.Columns>
            </DataGrid>
        </Grid>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Text="Choose a connected pedal." Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExportButton" Content="Export HIL report" Click="Export_Click" IsEnabled="False" Margin="0,0,8,0"/><Button Content="Close" Click="Close_Click"/></StackPanel>
        </Grid>
    </Grid>
</Window>
