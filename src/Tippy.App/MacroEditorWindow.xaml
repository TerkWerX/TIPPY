<Window x:Class="Tippy.App.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="900" Height="850" MinWidth="740" MinHeight="780"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="AssignmentHeading" Text="Assignment" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="AssignmentSubtitle" Text="Choose a Windows shortcut, a single key, an application command, or build a custom macro."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel x:Name="BindingTypePanel">
                    <TextBlock Text="ACTION TYPE" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="BindingTypeBox" SelectionChanged="BindingTypeBox_SelectionChanged">
                        <ComboBoxItem Tag="Macro"><TextBlock Text="Run an action or macro" Foreground="#111820"/></ComboBoxItem>
                        <ComboBoxItem Tag="BankNext"><TextBlock Text="Switch to next bank" Foreground="#111820"/></ComboBoxItem>
                        <ComboBoxItem Tag="Disabled"><TextBlock Text="Disabled" Foreground="#111820"/></ComboBoxItem>
                        <ComboBoxItem Tag="ShiftLayer"><TextBlock Text="Hold for temporary bank" Foreground="#111820"/></ComboBoxItem>
                    </ComboBox>
                </StackPanel>
                <StackPanel x:Name="TriggerModePanel" Grid.Column="2">
                    <TextBlock Text="PRESS BEHAVIOR" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,6"/>
                    <ComboBox x:Name="TriggerModeBox">
                        <ComboBoxItem Tag="PressOnce"><TextBlock Text="Run once when pressed" Foreground="#111820"/></ComboBoxItem>
                        <ComboBoxItem Tag="WhileHeld"><TextBlock Text="Hold keys/buttons until released" Foreground="#111820"/></ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Grid>
            <StackPanel x:Name="ShiftBankPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock Text="TEMPORARY BANK WHILE HELD" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="ShiftBankBox" Width="180" HorizontalAlignment="Left">
                    <ComboBoxItem><TextBlock Text="Bank 1" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem><TextBlock Text="Bank 2" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem><TextBlock Text="Bank 3" Foreground="#111820"/></ComboBoxItem>
                </ComboBox>
                <TextBlock Text="Other switches use this bank until the shift pedal is released. The saved active bank is not changed."
                           Style="{StaticResource SmallMutedText}" Margin="0,6,0,0"/>
            </StackPanel>
            <Border x:Name="ReleaseActionBorder" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="RELEASE ACTION" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                        <TextBlock x:Name="ReleaseActionSummary" Text="No action when released" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Edit release" Click="EditReleaseAction_Click" Margin="0,0,7,0"/>
                        <Button x:Name="ClearReleaseButton" Content="Clear" Click="ClearReleaseAction_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border x:Name="GestureActionsBorder" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ADVANCED FOOT BEHAVIORS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                        <TextBlock x:Name="GestureSummary" Text="Standard press/release" Margin="0,4,12,0" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <CheckBox x:Name="RepeatCheckBox" Content="Repeat press action while held" Margin="0,0,18,0"/>
                            <CheckBox x:Name="ToggleCheckBox" Content="Toggle held action on/off"/>
                        </StackPanel>
                        <WrapPanel Margin="0,7,0,0">
                            <TextBlock Text="Double window" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="DoubleWindowBox" Width="48" Margin="0,0,4,0"/><TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Long press" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="LongThresholdBox" Width="48" Margin="0,0,4,0"/><TextBlock Text="ms" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBlock Text="Repeat delay / interval" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="RepeatDelayBox" Width="48" Margin="0,0,4,0"/><TextBlock Text="/" VerticalAlignment="Center" Margin="0,0,4,0"/><TextBox x:Name="RepeatIntervalBox" Width="48" Margin="0,0,4,0"/><TextBlock Text="ms" VerticalAlignment="Center"/>
                        </WrapPanel>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Button Content="Double tap" Click="EditDoubleTap_Click" Margin="0,0,6,6"/>
                        <Button Content="Long press" Click="EditLongPress_Click" Margin="0,0,6,6"/>
                        <Button Content="Clear gestures" Click="ClearGestures_Click" Margin="0,0,0,6"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </StackPanel>
        <TabControl x:Name="MacroArea" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}">
            <TabItem>
                <TabItem.Header><TextBlock Text="Windows shortcuts" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SEARCH ALL SHORTCUTS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="ActionSearchBox" Grid.Column="1" TextChanged="ActionSearchBox_TextChanged" Padding="10,8"
                                 ToolTip="Search every Windows shortcut by action, key combination, or description"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="BROWSE BY PURPOSE" Style="{StaticResource SmallMutedText}"
                                           FontWeight="Bold" Margin="7,5,7,6"/>
                                <ListBox x:Name="ActionCategoryList" SelectionChanged="ActionCategoryList_SelectionChanged"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="5,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource SmallMutedText}" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="ActionsList" Grid.Column="2" MouseDoubleClick="ActionsList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="7,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" Margin="0,2,10,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="ActionCountText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                        <Button Content="Assign selected shortcut" Click="AssignAction_Click" HorizontalAlignment="Right"
                                Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Keyboard keys" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="SEARCH ALL KEYS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="KeySearchBox" Grid.Column="1" TextChanged="KeySearchBox_TextChanged" Padding="10,8"
                                 ToolTip="Search every individual keyboard, function, navigation, browser, media, or keypad key"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="7" Padding="6">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="KEY GROUP" Style="{StaticResource SmallMutedText}"
                                           FontWeight="Bold" Margin="7,5,7,6"/>
                                <ListBox x:Name="KeyCategoryList" SelectionChanged="KeyCategoryList_SelectionChanged"
                                         BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <StackPanel Margin="5,4">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding CountLabel}" Style="{StaticResource SmallMutedText}" FontSize="10" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                        <ListBox x:Name="KeysList" Grid.Column="2" MouseDoubleClick="KeysList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="7,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" Margin="0,2,10,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                    <Grid Grid.Row="2">
                        <TextBlock x:Name="KeyCountText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                        <Button Content="Assign selected key" Click="AssignKey_Click" HorizontalAlignment="Right"
                                Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Applications" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid x:Name="ApplicationsPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SEARCH ALL APPLICATIONS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ApplicationSearchBox" Grid.Column="1" TextChanged="ApplicationSearchBox_TextChanged" Padding="10,8"
                                     ToolTip="Search every application by name, publisher, or purpose"/>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="SOFTWARE TYPE" Style="{StaticResource SmallMutedText}"
                                               FontWeight="Bold" Margin="7,5,7,6"/>
                                    <ListBox x:Name="ApplicationCategoryList" SelectionChanged="ApplicationCategoryList_SelectionChanged"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="5,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource SmallMutedText}" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ListBox x:Name="ApplicationsList" Grid.Column="2" MouseDoubleClick="ApplicationsList_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Margin="8,7">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                            <TextBlock Style="{StaticResource SmallMutedText}" Margin="0,2,0,0">
                                                <Run Text="{Binding Publisher}"/><Run Text=" · "/><Run Text="{Binding Category}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock><Run Text="{Binding Shortcuts.Count, Mode=OneWay}"/><Run Text=" shortcuts"/></TextBlock>
                                        </Border>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ApplicationCountText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                            <Button Content="View shortcuts" Click="ViewApplication_Click" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ApplicationShortcutsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="← Applications" Click="BackToApplications_Click" Margin="0,0,12,0" Padding="10,6"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SelectedApplicationText" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock x:Name="SelectedApplicationNoteText" Style="{StaticResource SmallMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="SEARCH ALL COMMANDS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox x:Name="ApplicationShortcutSearchBox" Grid.Column="1" TextChanged="ApplicationShortcutSearchBox_TextChanged"
                                     Padding="10,8" ToolTip="Search commands or shortcuts in this application"/>
                        </Grid>
                        <Grid Grid.Row="2" Margin="0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="6">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="COMMAND TYPE" Style="{StaticResource SmallMutedText}"
                                               FontWeight="Bold" Margin="7,5,7,6"/>
                                    <ListBox x:Name="ApplicationShortcutCategoryList" SelectionChanged="ApplicationShortcutCategoryList_SelectionChanged"
                                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="5,4">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource SmallMutedText}" FontSize="10" Margin="0,1,0,0"/>
                                            </StackPanel>
                                        </DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                            <ListBox x:Name="ApplicationShortcutsList" Grid.Column="2" MouseDoubleClick="ApplicationShortcutsList_MouseDoubleClick"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate>
                                    <Grid Margin="7,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" Margin="0,2,10,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <Grid Grid.Row="3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ApplicationShortcutCountText" Style="{StaticResource SmallMutedText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Shortcuts can vary by version, workspace, and customized keymap." Style="{StaticResource SmallMutedText}" FontSize="10" VerticalAlignment="Center"/>
                                    <Button Content="Official reference" Click="OpenApplicationSource_Click" Padding="7,2" Margin="8,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Assign selected shortcut" Click="AssignApplicationShortcut_Click" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Custom macro" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="MACRO NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="NameBox"/></StackPanel>
                    <TextBlock Grid.Row="1" Text="MACRO STEPS" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,10,0,7"/>
                    <ListBox x:Name="StepsList" Grid.Row="2" SelectionMode="Single" Padding="5"/>
                    <TextBlock Grid.Row="3" Text="ADD A STEP" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,9,0,5"/>
                    <TabControl Grid.Row="4" MinHeight="104" Background="{DynamicResource SurfaceAltBrush}"
                                BorderBrush="{DynamicResource BorderBrush}">
                        <TabItem>
                            <TabItem.Header><TextBlock Text="Keyboard, text &amp; timing" Foreground="#111820"/></TabItem.Header>
                            <Grid Margin="8">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox x:Name="TextStringBox" Padding="8" ToolTip="Text Tippy will type exactly as entered"/>
                                    <Button Grid.Column="2" Content="Add typed string" Click="AddString_Click"/>
                                </Grid>
                                <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                    <Button x:Name="RecordButton" Content="Record with timing" Click="Record_Click" Margin="0,0,7,0" Background="{DynamicResource AccentSoftBrush}"/>
                                    <Button x:Name="CaptureButton" Content="Capture key combination" Click="CaptureShortcut_Click" Margin="0,0,7,0"/>
                                    <Button Content="Prompt for text" Click="AddText_Click" Margin="0,0,7,0"/>
                                    <Button Content="Add wait" Click="AddDelay_Click"/>
                                </WrapPanel>
                            </Grid>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header><TextBlock Text="Mouse &amp; gamepad" Foreground="#111820"/></TabItem.Header>
                            <WrapPanel Margin="10">
                                <Button Content="Mouse button, movement, or scroll" Click="AddMouse_Click" Margin="0,0,8,0"/>
                                <Button Content="Virtual gamepad" Click="AddGamepad_Click"/>
                            </WrapPanel>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header><TextBlock Text="Programs &amp; signals" Foreground="#111820"/></TabItem.Header>
                            <WrapPanel Margin="10">
                                <Button Content="Launch program" Click="AddProgram_Click" Margin="0,0,8,0"/>
                                <Button Content="Send MIDI" Click="AddMidi_Click" Margin="0,0,8,0"/>
                                <Button Content="Send OSC" Click="AddOsc_Click"/>
                            </WrapPanel>
                        </TabItem>
                    </TabControl>
                    <Grid Grid.Row="5" Margin="0,5,0,0">
                        <TextBlock x:Name="CaptureHint" Text="Steps run from top to bottom." Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="↑" Click="MoveUp_Click" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="↓" Click="MoveDown_Click" Padding="10,5" Margin="0,0,5,0"/>
                            <Button Content="Remove" Click="RemoveStep_Click" Padding="10,5"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save assignment" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/></StackPanel>
    </Grid>
</Window>
