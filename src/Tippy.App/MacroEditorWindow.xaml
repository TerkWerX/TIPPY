<Window x:Class="Tippy.App.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="860" Height="760" MinWidth="720" MinHeight="630"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Assignment" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="Pick a Windows or application shortcut, type a string, or build and record a custom macro."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="ACTION TYPE" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="BindingTypeBox" SelectionChanged="BindingTypeBox_SelectionChanged">
                    <ComboBoxItem Tag="Macro"><TextBlock Text="Run an action or macro" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem Tag="BankNext"><TextBlock Text="Switch to next bank" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem Tag="Disabled"><TextBlock Text="Disabled" Foreground="#111820"/></ComboBoxItem>
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="TRIGGER BEHAVIOR" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,6"/>
                <ComboBox x:Name="TriggerModeBox">
                    <ComboBoxItem Tag="PressOnce"><TextBlock Text="Run once when pressed" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem Tag="WhileHeld"><TextBlock Text="Hold keys/buttons until released" Foreground="#111820"/></ComboBoxItem>
                    <ComboBoxItem Tag="ReleaseOnce"><TextBlock Text="Run once when released" Foreground="#111820"/></ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Grid>
        <TabControl x:Name="MacroArea" Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" Foreground="{DynamicResource TextBrush}">
            <TabItem>
                <TabItem.Header><TextBlock Text="Windows actions &amp; keys" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBox x:Name="ActionSearchBox" TextChanged="ActionSearchBox_TextChanged" Padding="10,8" ToolTip="Type an action, shortcut, or key name"/>
                    <ListBox x:Name="ActionsList" Grid.Row="1" Margin="0,10" MouseDoubleClick="ActionsList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="7,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" Margin="0,2,10,0" TextWrapping="Wrap"/></StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource SurfaceAltBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontWeight="SemiBold"/></Border>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2"><TextBlock x:Name="ActionCountText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/><Button Content="Assign selected action" Click="AssignAction_Click" HorizontalAlignment="Right" Background="{DynamicResource AccentBrush}" Foreground="#101820"/></Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Applications" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid x:Name="ApplicationsPanel">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBox x:Name="ApplicationSearchBox" TextChanged="ApplicationSearchBox_TextChanged" Padding="10,8"
                                 ToolTip="Search by application, publisher, or category"/>
                        <ListBox x:Name="ApplicationsList" Grid.Row="1" Margin="0,10" MouseDoubleClick="ApplicationsList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="8,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource SmallMutedText}" Margin="0,2,0,0">
                                            <Run Text="{Binding Publisher}"/><Run Text=" · "/><Run Text="{Binding Category}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,5" VerticalAlignment="Center">
                                        <TextBlock><Run Text="{Binding Shortcuts.Count, Mode=OneWay}"/><Run Text=" shortcuts"/></TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="2">
                            <TextBlock x:Name="ApplicationCountText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
                            <Button Content="View shortcuts" Click="ViewApplication_Click" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                        </Grid>
                    </Grid>

                    <Grid x:Name="ApplicationShortcutsPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="← Applications" Click="BackToApplications_Click" Margin="0,0,12,0" Padding="10,6"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="SelectedApplicationText" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SelectedApplicationNoteText" Style="{StaticResource SmallMutedText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="ApplicationShortcutSearchBox" Grid.Row="1" TextChanged="ApplicationShortcutSearchBox_TextChanged"
                                 Margin="0,10,0,0" Padding="10,8" ToolTip="Search commands or shortcuts in this application"/>
                        <ListBox x:Name="ApplicationShortcutsList" Grid.Row="2" Margin="0,10" MouseDoubleClick="ApplicationShortcutsList_MouseDoubleClick"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate><DataTemplate>
                                <Grid Margin="7,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" Margin="0,2,10,0" TextWrapping="Wrap"/></StackPanel>
                                    <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="9,5" VerticalAlignment="Center"><TextBlock Text="{Binding Shortcut}" FontFamily="Consolas" FontWeight="SemiBold"/></Border>
                                </Grid>
                            </DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Grid Grid.Row="3">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="ApplicationShortcutCountText" Style="{StaticResource SmallMutedText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="Shortcuts can vary by version, workspace, and customized keymap." Style="{StaticResource SmallMutedText}" FontSize="10" VerticalAlignment="Center"/>
                                    <Button Content="Official reference" Click="OpenApplicationSource_Click" Padding="7,2" Margin="8,0,0,0" FontSize="10"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="Assign selected shortcut" Click="AssignApplicationShortcut_Click" HorizontalAlignment="Right"
                                    Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header><TextBlock Text="Macro &amp; text" Foreground="#111820"/></TabItem.Header>
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="MACRO NAME" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,5"/><TextBox x:Name="NameBox"/></StackPanel>
                    <Grid Grid.Row="1" Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="TextStringBox" Padding="8" ToolTip="Text Tippy will type exactly as entered"/><Button Grid.Column="2" Content="Add typed string" Click="AddString_Click"/></Grid>
                    <TextBlock Grid.Row="2" Text="MACRO STEPS" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,7"/>
                    <ListBox x:Name="StepsList" Grid.Row="3" SelectionMode="Single" Padding="5"/>
                    <WrapPanel Grid.Row="4" Margin="0,10,0,0"><Button x:Name="RecordButton" Content="Start timed recording" Click="Record_Click" Margin="0,0,7,7" Background="{DynamicResource AccentSoftBrush}"/><Button x:Name="CaptureButton" Content="Capture shortcut" Click="CaptureShortcut_Click" Margin="0,0,7,7"/><Button Content="Type text" Click="AddText_Click" Margin="0,0,7,7"/><Button Content="Wait" Click="AddDelay_Click" Margin="0,0,7,7"/><Button Content="Mouse" Click="AddMouse_Click" Margin="0,0,7,7"/><Button Content="Gamepad" Click="AddGamepad_Click" Margin="0,0,7,7"/></WrapPanel>
                    <Grid Grid.Row="5" Margin="0,3,0,0"><TextBlock x:Name="CaptureHint" Text="Steps run from top to bottom." Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↑" Click="MoveUp_Click" Padding="10,5" Margin="0,0,5,0"/><Button Content="↓" Click="MoveDown_Click" Padding="10,5" Margin="0,0,5,0"/><Button Content="Remove" Click="RemoveStep_Click" Padding="10,5"/></StackPanel></Grid>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save assignment" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/></StackPanel>
    </Grid>
</Window>
