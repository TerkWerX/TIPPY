<Window x:Class="Tippy.App.StatusOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="390" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Topmost="True" Background="Transparent" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False">
    <Border Background="#E9111821" BorderBrush="#CC5DDDE0" BorderThickness="1" CornerRadius="14" Padding="16">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="/Tippy;component/Assets/Branding/tippy-toes-t.png" Width="42" Height="54" Stretch="Uniform" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ContextText" Foreground="#B7CFE2" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
