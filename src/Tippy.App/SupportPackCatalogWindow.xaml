<Window x:Class="Tippy.App.SupportPackCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy pedal support packs" Width="820" Height="620" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Pedal support packs" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Browse trusted publisher packs, see installed versions, and install authenticated updates. Downloads are checked against the catalog and the publisher's RSA signature before files are installed."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <TextBlock x:Name="TrustText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
            <Button Content="Refresh catalog" Click="Refresh_Click" HorizontalAlignment="Right"/>
        </Grid>
        <ListBox Grid.Row="2" x:Name="PacksList" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,0,0,9">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Description}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,16,0"/>
                            <TextBlock Text="{Binding PublisherLine}" Style="{StaticResource SmallMutedText}" Margin="0,7,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ActionLabel}" Tag="{Binding}" Click="Install_Click" VerticalAlignment="Center" IsEnabled="{Binding CanInstall}" Background="{DynamicResource AccentSoftBrush}"/>
                    </Grid>
                </Border>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" Margin="0,0,220,0" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Install local pack…" Click="InstallLocal_Click" Margin="0,0,8,0"/><Button Content="Close" IsCancel="True"/></StackPanel>
        </Grid>
    </Grid>
</Window>
