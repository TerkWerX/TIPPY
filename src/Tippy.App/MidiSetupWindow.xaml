<Window x:Class="Tippy.App.MidiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy MIDI output setup" Width="650" Height="500" MinWidth="570" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="MIDI output" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Choose where every MIDI macro in this profile is sent. Tippy opens the port only when a message is sent."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <TextBlock Text="OUTPUT DEVICE" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,7"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="OutputCombo" DisplayMemberPath="DisplayName" MinHeight="36" SelectionChanged="OutputCombo_SelectionChanged"/>
                <Button Grid.Column="1" Content="Rescan" Click="Rescan_Click" Margin="9,0,0,0"/>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Live output test" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="MidiStatusText" Text="Select an output, then send a short middle-C test note."
                               Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,5,15,0"/>
                </StackPanel>
                <Button x:Name="TestButton" Grid.Column="1" Content="Send test note" Click="Test_Click"
                        VerticalAlignment="Center" Background="{DynamicResource AccentSoftBrush}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,18,0,0">
            <TextBlock Text="SUPPORTED SHORT MESSAGES" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
            <TextBlock FontFamily="Consolas" Margin="0,8,0,0" TextWrapping="Wrap"><Run Text="note:1:60:100"/><LineBreak/><Run Text="noteoff:1:60:0"/><LineBreak/><Run Text="cc:1:64:127"/><LineBreak/><Run Text="pc:1:10"/></TextBlock>
            <TextBlock Text="Channels are 1–16; notes, velocities, controllers, values, and programs are 0–127. For a sustained note, assign note-on to the pedal press and note-off to its release action."
                       Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save MIDI output" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
