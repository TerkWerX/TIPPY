<Window x:Class="Tippy.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy settings" Width="680" Height="700" ResizeMode="CanResize" MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Global bank switching and optional controller output."
                       Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,24,0,20">
            <TextBlock Text="BANK SWITCH HOTKEY" Style="{StaticResource SmallMutedText}" FontWeight="Bold" Margin="0,0,0,7"/>
            <Grid>
                <TextBox x:Name="HotkeyBox" IsReadOnly="True" FontSize="15"/>
                <Button x:Name="CaptureHotkeyButton" Content="Change" HorizontalAlignment="Right" Margin="4" Padding="13,4"
                        Click="CaptureHotkey_Click"/>
            </Grid>
            <TextBlock x:Name="HotkeyHint" Text="Works globally, even when Tippy is not focused."
                       Style="{StaticResource SmallMutedText}" Margin="0,6,0,0"/>
            <CheckBox x:Name="StartMinimizedCheckBox" Content="Start Tippy in the notification area"
                      Margin="0,14,0,0"/>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Virtual Xbox controller" FontWeight="SemiBold" FontSize="15"/>
                    <TextBlock x:Name="GamepadStatusText" Text="Not tested" TextWrapping="Wrap"
                               Style="{StaticResource SmallMutedText}" Margin="0,5,15,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Test driver" Click="TestGamepad_Click" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="9" Padding="15" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="OVERLAY, VARIABLES &amp; SAFETY" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/>
                <CheckBox x:Name="OverlayEnabledCheckBox" Content="Show a click-through bank/action overlay" Margin="0,9,0,0"/>
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="Visible seconds" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="OverlaySecondsBox" Width="48" Margin="0,0,16,0"/>
                    <TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="OverlayLeftBox" Width="64" Margin="0,0,16,0"/>
                    <TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="OverlayTopBox" Width="64"/>
                </WrapPanel>
                <WrapPanel Margin="0,12,0,0">
                    <TextBlock Text="Max macro seconds" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="MacroSecondsBox" Width="58" Margin="0,0,16,0"/>
                    <TextBlock Text="Max repeat seconds" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="RepeatSecondsBox" Width="58" Margin="0,0,16,0"/>
                    <TextBlock Text="Max steps" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBox x:Name="MaximumStepsBox" Width="68"/>
                </WrapPanel>
                <TextBlock Text="Emergency-stop shortcut" Margin="0,10,0,4"/><TextBox x:Name="EmergencyHotkeyBox"/>
                <TextBlock Text="PROFILE VARIABLES — one name=value per line. Use {name}, {date}, {time}, {clipboard}, {app}, {device}, {pedal}, or {bank} in text and program fields."
                           Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,10,0,4"/>
                <TextBox x:Name="VariablesBox" AcceptsReturn="True" Height="76" VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="Keyboard and mouse macros work without another driver. Gamepad steps need ViGEmBus 1.22 or a compatible virtual-controller bus installed; Tippy never installs a kernel driver automatically."
                   TextWrapping="Wrap" Style="{StaticResource SmallMutedText}" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="Save settings" Click="Save_Click" Background="{DynamicResource AccentBrush}" Foreground="#101820"/>
        </StackPanel>
    </Grid>
</Window>
