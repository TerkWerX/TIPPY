<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>Tippy</AssemblyName>
    <RootNamespace>Tippy.App</RootNamespace>
    <Version>0.6.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Icons\tippy.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tippy.Core\Tippy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Mascot\tippy-toes-master.png" />
    <Resource Include="Assets\Branding\*.png" />
    <Resource Include="Assets\Pedals\*.png" />
    <Resource Include="Assets\Icons\tippy.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\Claude\pedals\pedal_registry.json" Link="PedalLibrary\pedal_registry.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Claude\pedals\*.png" Link="PedalLibrary\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\Claude\pedals\manifest.csv" Link="PedalLibrary\manifest.csv"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\pedal-packs\trusted-publishers.json" Link="PedalPacks\trusted-publishers.json"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
