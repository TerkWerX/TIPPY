<Window x:Class="Tippy.App.PedalArtworkPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose pedal picture" Width="760" Height="570" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Choose the picture that matches your pedal" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="DeviceText" Style="{StaticResource SmallMutedText}" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ArtworkList" DisplayMemberPath="DisplayName"
                     SelectionChanged="ArtworkList_SelectionChanged"/>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" SnapsToDevicePixels="True"/>
                    <TextBlock x:Name="PlaceholderText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="22" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>
            </Border>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Use this picture" Click="Save_Click" Background="{DynamicResource AccentBrush}"/>
        </StackPanel>
    </Grid>
</Window>
