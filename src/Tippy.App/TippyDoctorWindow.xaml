<Window x:Class="Tippy.App.TippyDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy Doctor" Width="940" Height="700" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        Icon="/Tippy;component/Assets/Icons/tippy.ico">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Tippy Doctor" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock Text="One local, privacy-safe health check for pedals, profiles, safety controls, outputs, and recovery."
                           Style="{StaticResource SmallMutedText}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                <TextBlock x:Name="OverallText" Text="Checking…" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="PASSED" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="PassedText" Text="0" FontSize="22" Foreground="{DynamicResource SuccessBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="WARNINGS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="WarningText" Text="0" FontSize="22" Foreground="{DynamicResource PressedBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <StackPanel><TextBlock Text="FAILED" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="FailedText" Text="0" FontSize="22" Foreground="{DynamicResource DangerBrush}"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel><TextBlock Text="PEDALS" Style="{StaticResource SmallMutedText}" FontWeight="Bold"/><TextBlock x:Name="PedalsText" Text="0" FontSize="22"/></StackPanel>
            </Border>
        </Grid>

        <ListBox Grid.Row="2" x:Name="ChecksList" BorderThickness="0" Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="StatusBadge" Width="30" Height="30" CornerRadius="15"
                                    Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock x:Name="StatusSymbol" Text="{Binding Symbol}" FontSize="17" FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource SmallMutedText}" FontWeight="Bold"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding Details}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Warning">
                            <Setter TargetName="StatusBadge" Property="Background" Value="#4C4020"/>
                            <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource PressedBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Fail">
                            <Setter TargetName="StatusBadge" Property="Background" Value="#4B2830"/>
                            <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Info">
                            <Setter TargetName="StatusBadge" Property="Background" Value="{DynamicResource SurfaceAltBrush}"/>
                            <Setter TargetName="StatusSymbol" Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="ActionStatusText" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button Content="Run checks again" Click="RunAgain_Click" Margin="0,0,8,0"/>
                <Button Content="Release held inputs" Click="ReleaseInputs_Click" Margin="0,0,8,0"/>
                <Button Content="Find compatible apps" Click="FindApps_Click" Margin="0,0,8,0"/>
                <Button Content="Export report" Click="Export_Click" Margin="0,0,8,0" Background="{DynamicResource AccentSoftBrush}"/>
                <Button Content="Close" IsCancel="True"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
