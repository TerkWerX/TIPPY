<Window x:Class="Tippy.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tippy — Foot Control Macros" Height="820" Width="1240"
        MinHeight="650" MinWidth="920" WindowStartupLocation="CenterScreen"
        Icon="/Tippy;component/Assets/Icons/tippy.ico"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="CompactModeBar" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="10,7" Visibility="Collapsed">
            <Grid>
                <TextBlock Text="Compact pedal view" Style="{StaticResource SmallMutedText}"
                           VerticalAlignment="Center" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="¼ view" Click="SubCompactMode_Click" Padding="10,5" Margin="0,0,7,0"
                            ToolTip="Switch to the minimalist one-quarter-size pedal view"/>
                    <Button Content="Full view" Click="ExitCompactMode_Click"
                            Padding="12,5" ToolTip="Restore Tippy's complete interface (Esc or F11)"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="HeaderBorder" Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="BrandBadge" Grid.Column="0" Background="#E6E8EB" BorderBrush="#C8CDD3"
                        BorderThickness="1" CornerRadius="7" Padding="8,3,10,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="BrandTopRow" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Image x:Name="HeaderMascot" Source="/Tippy;component/Assets/Branding/tippy-toes-t.png"
                                   Width="66" Height="86" Margin="0,-1,-4,-1"
                                   Stretch="Uniform" SnapsToDevicePixels="True"
                                   IsHitTestVisible="False"
                                   AutomationProperties.Name="Tippy Toes mascot"/>
                            <Image x:Name="HeaderWordmark" Source="/Tippy;component/Assets/Branding/tippy-tattoo-wordmark.png"
                                   Width="112" Height="76" Margin="0,0,0,-1" Stretch="Uniform" VerticalAlignment="Center"
                                   SnapsToDevicePixels="True" IsHitTestVisible="False"
                                   AutomationProperties.Name="TIPPY tattoo wordmark"/>
                        </StackPanel>
                        <TextBlock x:Name="HeaderTagline" Grid.Row="1" Text="Foot control → fast macros"
                                   Foreground="#46586A" FontSize="12" Margin="0,-5,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Open profile" Click="OpenProfile_Click" Margin="0,0,8,0"/>
                    <Button Content="Save as" Click="SaveProfile_Click" Margin="0,0,8,0"/>
                    <Button Content="App profiles" Click="ApplicationProfiles_Click" Margin="0,0,8,0"/>
                    <Button Content="Settings" Click="Settings_Click" Margin="0,0,8,0"/>
                    <Button Content="To tray" Click="MinimizeToTray_Click" Margin="0,0,8,0" ToolTip="Keep Tippy running in the notification area"/>
                    <Button x:Name="CompactModeButton" Content="Compact view" Click="CompactMode_Click" Margin="0,0,8,0"
                            ToolTip="Hide menus and show one full-size pedal at a time (F11)"/>
                    <Button Content="¼ view" Click="SubCompactMode_Click" Margin="0,0,8,0"
                            ToolTip="Sub-compact: show one quarter-size pedal with no labels or menus"/>
                    <Button Content="Tools" Click="Tools_Click" Margin="0,0,8,0"/>
                    <Button Content="Help" Click="Help_Click" Margin="0,0,8,0"/>
                    <Button x:Name="ThemeButton" Content="Light mode" Click="Theme_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="AllPedalsBorder" Grid.Row="1" Background="{DynamicResource SurfaceAltBrush}" Padding="24,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="ALL PEDALS" FontSize="11" FontWeight="Bold"
                           Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel x:Name="BankButtonsPanel" Grid.Column="1" Orientation="Horizontal"/>
                <TextBlock x:Name="BankHintText" Grid.Column="2" Style="{StaticResource SmallMutedText}"
                           Text="Ctrl + Alt + B switches bank" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="DevicesScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="{DynamicResource BackgroundBrush}">
            <StackPanel x:Name="DevicesContent" Margin="24,22,24,30">
                <Grid x:Name="DevicesToolbar" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Foot controls" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="Press a pedal to run its assignment. Edit any tile to build the macro."
                                   Style="{StaticResource SmallMutedText}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="Layout" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <ComboBox x:Name="DeviceLayoutBox" Width="118" Margin="0,0,12,0"
                                  SelectionChanged="DeviceLayoutBox_SelectionChanged">
                            <ComboBox.Resources>
                                <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111820"/></Style>
                            </ComboBox.Resources>
                            <ComboBoxItem Tag="Auto"><TextBlock Text="Auto" Foreground="#111820"/></ComboBoxItem>
                            <ComboBoxItem Tag="Stacked"><TextBlock Text="Stacked" Foreground="#111820"/></ComboBoxItem>
                            <ComboBoxItem Tag="SideBySide"><TextBlock Text="Side by side" Foreground="#111820"/></ComboBoxItem>
                            <ComboBoxItem Tag="Tiled"><TextBlock Text="Tiles" Foreground="#111820"/></ComboBoxItem>
                            <ComboBoxItem Tag="Tabbed"><TextBlock Text="Tabbed pedals" Foreground="#111820"/></ComboBoxItem>
                        </ComboBox>
                        <StackPanel x:Name="TileColumnsPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,12,0">
                            <TextBlock Text="Columns" Style="{StaticResource SmallMutedText}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <ComboBox x:Name="TileColumnsBox" Width="88" SelectionChanged="TileColumnsBox_SelectionChanged">
                                <ComboBox.Resources>
                                    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#111820"/></Style>
                                </ComboBox.Resources>
                                <ComboBoxItem Tag="0"><TextBlock Text="Auto" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="1"><TextBlock Text="1" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="2"><TextBlock Text="2" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="3"><TextBlock Text="3" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="4"><TextBlock Text="4" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="5"><TextBlock Text="5" Foreground="#111820"/></ComboBoxItem>
                                <ComboBoxItem Tag="6"><TextBlock Text="6" Foreground="#111820"/></ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                        <Button Content="Learn new pedal" Click="LearnPedal_Click" Margin="0,0,8,0"
                                Background="{DynamicResource AccentSoftBrush}"/>
                        <Button Content="Scan USB" Click="Scan_Click"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="DevicesPanel"/>
                <Border x:Name="EmptyState" Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="35" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="No compatible foot controls found" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Plug in a supported pedal, choose Scan USB, or use Learn new pedal / Tools for Raw Input hardware."
                                   Style="{StaticResource SmallMutedText}" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border x:Name="StatusBorder" Grid.Row="3" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource MutedTextBrush}" Margin="0,0,9,0"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="Starting…" Style="{StaticResource SmallMutedText}"/>
                <TextBlock x:Name="RawReportText" Grid.Column="2" Text="HID idle" Style="{StaticResource SmallMutedText}"/>
            </Grid>
        </Border>

        <Grid x:Name="SubCompactSurface" Grid.Row="0" Grid.RowSpan="4"
              Background="{DynamicResource BackgroundBrush}" Visibility="Collapsed" Panel.ZIndex="20"
              MouseLeftButtonDown="SubCompactSurface_MouseLeftButtonDown">
            <Grid x:Name="SubCompactPedalHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel x:Name="SubCompactDotsPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Bottom" Margin="0,0,0,5"/>
            <Button Content="↗" Click="ExitSubCompactMode_Click" Width="28" Height="24" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0"
                    FontSize="14" ToolTip="Return to the full Tippy interface"
                    AutomationProperties.Name="Return to full view"/>
        </Grid>
    </Grid>
</Window>
